# --- Project data & artifacts ---
# Processed splits are regenerated from data/raw/shipments.csv, so they are not
# tracked. The negation keeps the .gitkeep so the directory itself survives a
# fresh clone -- a bare "data/processed/" rule would exclude the directory
# outright and git would never descend into it to see the exception.
data/processed/*
!data/processed/.gitkeep

# Trained models are build outputs, rebuilt by src/models/train.py.
models/*.joblib

